{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "SecretKey": "$(SecretKey)",
    "Issuer": "$(Issuer)",
    "Audience": "$(Audience)",
    "TokenExpireTime": 10,
    "RefreshTokenExpireTime": 7
  },
  "ConnectionStrings": {
    "DefaultConnection": "$(AuthDB)"
  },
  "EmailSettings": {
    "smtpServer": "smtp.gmail.com",
    "smtpPort": 587,
    "fromEmail": "$(fromEmail)",
    "fromPassword": "$(fromPassword)"
  },
  "AllowedHosts": "*"
}