{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "SecretKey": "__SecretKey__",
    "Issuer": "__Issuer__",
    "Audience": "__Audience__",
    "TokenExpireTime": 10,
    "RefreshTokenExpireTime": 7
  },
  "ConnectionStrings": {
    "DefaultConnection": "__AuthDB__"
  },
  "EmailSettings": {
    "smtpServer": "smtp.gmail.com",
    "smtpPort": 587,
    "fromEmail": "__fromEmail__",
    "fromPassword": "__fromPassword__"
  },
  "AllowedHosts": "*"
}
