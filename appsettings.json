{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "SecretKey": "$(CRDeployVariables.SecretKey)",
    "Issuer": "$(CRDeployVariables.Issuer)",
    "Audience": "$(CRDeployVariables.Audience)",
    "TokenExpireTime": 10,
    "RefreshTokenExpireTime": 7
  },
  "ConnectionStrings": {
    "DefaultConnection": "$(CRDeployVariables.AuthDB)"
  },
  "EmailSettings": {
    "smtpServer": "smtp.gmail.com",
    "smtpPort": 587,
    "fromEmail": "$(CRDeployVariables.fromEmail)",
    "fromPassword": "$(CRDeployVariables.fromPassword)"
  },
  "AllowedHosts": "*"
}